rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bloques de 30 minutos; una cita ocupa como máximo 4 (MAX_BLOQUES_POR_CITA en la app).
    // Las fechas y horas se guardan en hora de Lima (UTC-5, sin horario de verano).

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdministrador() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    function rutaCandado(barberoId, fecha, hora) {
      return /databases/$(database)/documents/horarios_ocupados/$(barberoId + '_' + fecha + '_' + hora);
    }

    function rutaCita(citaId) {
      return /databases/$(database)/documents/citas/$(citaId);
    }

    function esFecha(fecha) {
      return fecha is string && fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function esHora(hora) {
      return hora is string && hora.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
    }

    function minutosDelDia(hora) {
      return int(hora.split(':')[0]) * 60 + int(hora.split(':')[1]);
    }

    function dia(fecha) {
      return timestamp.date(int(fecha.split('-')[0]), int(fecha.split('-')[1]), int(fecha.split('-')[2]));
    }

    // Instante real (UTC) en que empieza la cita: hora de Lima + 5 horas.
    function inicioCita(fecha, hora) {
      return dia(fecha) + duration.value(minutosDelDia(hora) + 300, 'm');
    }

    // Las citas anteriores a la duración por servicio no tienen "bloques": ocupaban solo su hora.
    function bloquesDe(cita) {
      return cita.get('bloques', [cita.hora]);
    }

    // El bloque i debe ser consecutivo al anterior y tener su candado creado en la misma transacción.
    function bloqueReservado(cita, i, citaId) {
      return cita.bloques.size() <= i
        || (minutosDelDia(cita.bloques[i]) == minutosDelDia(cita.hora) + 30 * i
          && getAfter(rutaCandado(cita.barberoId, cita.fecha, cita.bloques[i])).data.citaId == citaId);
    }

    function bloqueLiberado(cita, i) {
      return bloquesDe(cita).size() <= i
        || !existsAfter(rutaCandado(cita.barberoId, cita.fecha, bloquesDe(cita)[i]));
    }

    function esReservaValida(cita, citaId) {
      let barbero = get(/databases/$(database)/documents/barberos/$(cita.barberoId)).data;
      let servicio = get(/databases/$(database)/documents/servicios/$(cita.servicioId)).data;
      let duracion = servicio.get('duracionMinutos', 30);
      let inicioAtencion = minutosDelDia(barbero.get('horaInicio', '09:00'));
      let finAtencion = minutosDelDia(barbero.get('horaFin', '20:00'));
      return esFecha(cita.fecha)
        && esHora(cita.hora)
        && cita.bloques is list
        && cita.bloques.size() >= 1
        && cita.bloques.size() <= 4
        && cita.bloques[0] == cita.hora
        && cita.duracionMinutos == duracion
        && (cita.bloques.size() * 30 >= duracion || cita.bloques.size() == 4)
        && cita.precio == servicio.precio
        && barbero.activo == true
        // Día laborable del barbero (1 = lunes ... 7 = domingo).
        && dia(cita.fecha).dayOfWeek() in barbero.diasLaborables
        // Dentro del horario de atención y alineada a los bloques de 30 minutos.
        && minutosDelDia(cita.hora) >= inicioAtencion
        && (minutosDelDia(cita.hora) - inicioAtencion) % 30 == 0
        && minutosDelDia(cita.hora) + 30 * cita.bloques.size() <= finAtencion
        // Nunca en el pasado.
        && inicioCita(cita.fecha, cita.hora) > request.time
        && bloqueReservado(cita, 0, citaId)
        && bloqueReservado(cita, 1, citaId)
        && bloqueReservado(cita, 2, citaId)
        && bloqueReservado(cita, 3, citaId);
    }

    function esCandadoDeCitaPropia(candado) {
      let cita = getAfter(rutaCita(candado.citaId)).data;
      return cita.clienteId == request.auth.uid
        && cita.barberoId == candado.barberoId
        && cita.fecha == candado.fecha
        && candado.hora in cita.bloques;
    }

    // Perfiles: cada usuario gestiona el suyo y no puede asignarse otro rol.
    match /usuarios/{uid} {
      allow read: if request.auth.uid == uid || esAdministrador();
      allow create: if request.auth.uid == uid && request.resource.data.rol == 'cliente';
      allow update: if request.auth.uid == uid && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    // Catálogos: solo lectura para clientes.
    match /servicios/{servicioId} {
      allow read: if estaAutenticado();
      allow write: if esAdministrador();
    }

    match /barberos/{barberoId} {
      allow read: if estaAutenticado();
      allow write: if esAdministrador();
    }

    match /citas/{citaId} {
      allow read: if estaAutenticado()
        && (resource.data.clienteId == request.auth.uid || esAdministrador());

      // Solo se crea junto con los candados de todos sus bloques (misma transacción), a nombre propio y en estado "reservada".
      allow create: if estaAutenticado()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.estado == 'reservada'
        && request.resource.data.creadaEn == request.time
        && esReservaValida(request.resource.data, citaId);

      // El cliente solo puede pasar su cita de "reservada" a "cancelada" y debe liberar todos sus candados en el mismo batch.
      allow update: if esAdministrador()
        || (resource.data.clienteId == request.auth.uid
          && resource.data.estado == 'reservada'
          && request.resource.data.estado == 'cancelada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && bloqueLiberado(resource.data, 0)
          && bloqueLiberado(resource.data, 1)
          && bloqueLiberado(resource.data, 2)
          && bloqueLiberado(resource.data, 3));

      allow delete: if false;
    }

    // Candado por bloque: no contiene datos personales, por eso cualquier usuario autenticado lo puede leer.
    match /horarios_ocupados/{candadoId} {
      allow read: if estaAutenticado();

      allow create: if estaAutenticado()
        && candadoId == request.resource.data.barberoId + '_' + request.resource.data.fecha + '_' + request.resource.data.hora
        && esCandadoDeCitaPropia(request.resource.data);

      // Nunca se sobrescribe: si el bloque ya existe, la reserva debe fallar.
      allow update: if false;

      allow delete: if esAdministrador()
        || (get(rutaCita(resource.data.citaId)).data.clienteId == request.auth.uid
          && getAfter(rutaCita(resource.data.citaId)).data.estado == 'cancelada');
    }
  }
}
